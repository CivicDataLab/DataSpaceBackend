DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgresuser
DB_PASSWORD=postgrespassword
DB_HOST=backend_db
DB_PORT=5432
TELEMETRY_URL=http://otel-collector:4317
ELASTICSEARCH_INDEX=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elasticuser
ELASTICSEARCH_PASS=elasticpass
URL_WHITELIST=http://localhost:8000,http://localhost,http://localhost:3000
DEBUG=True
SECRET_KEY=your-secret-key
REDIS_URL=redis://redis:6379/1

# Third-party platform imports (optional)
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=
GITHUB_TOKEN=

# URLs written into exported metadata (DCAT / Croissant); set per environment
PUBLIC_SITE_URL=https://civicdataspace.in
PUBLIC_API_URL=https://api.datakeep.civicdays.in

# Media storage (S3 only; required). STORAGE_ENV prefixes every key: use
# "local" for local development against the dev bucket. Leave the access keys
# empty on ECS/EC2 so the task role is used. STORAGE_PUBLIC_BASE_URL is the
# base for public asset URLs (CDN or bucket URL); empty uses the S3 bucket URL.
STORAGE_BUCKET=dataspace-dev
STORAGE_REGION=ap-south-1
STORAGE_ENV=local
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Per-IP request throttling (api/middleware/rate_limit.py). False on dev only.
RATE_LIMIT_ENABLED=True

# Query-engine data layer (internal endpoints under /api/internal/qe/).
# Docs: api/views/query_engine/architecture.md
QE_SERVICE_CLIENT_ID=dataspace-query-engine-service
QE_SERVICE_ROLE=query-engine-service
# Rollout narrowing: sector slugs (sub-sectors included) and collaborative public ids.
QE_PLATFORM_SECTORS=
QE_ENABLED_COLLABORATIVES=
QE_SEARCH_INDEX=qe_catalog
QE_EMBEDDINGS_URL=https://openrouter.ai/api/v1
QE_EMBEDDINGS_MODEL=google/gemini-embedding-2
QE_EMBEDDINGS_API_KEY=
QE_EMBEDDINGS_DIMS=1536
QE_RERANK_URL=https://openrouter.ai/api/v1
QE_RERANK_API_KEY=
QE_RERANK_MODEL=cohere/rerank-5-pro
QE_RERANK_DOC_CHARS=4000
# Trying another embedding model: model, size, batch size and optional query/document hints;
# a new size needs `python manage.py qe_sync --rebuild-index`.
QE_EMBEDDINGS_BATCH_SIZE=32
QE_EMBEDDINGS_QUERY_INPUT_TYPE=
QE_EMBEDDINGS_DOC_INPUT_TYPE=
QE_EMBEDDINGS_QUERY_PREFIX=
QE_EMBEDDINGS_DOC_PREFIX=
# Weak-match thresholds (leave QE_WEAK_MATCH_RERANK unset to use the reranker's own).
QE_WEAK_MATCH_SIMILARITY=0.55
# QE_WEAK_MATCH_RERANK=0.3
# Time limits (ms) and caps of the data reader and the qe_sync process.
QE_QUERY_TIMEOUT_MS=5000
QE_PROFILE_TIMEOUT_MS=4000
QE_LOCK_TIMEOUT_MS=2000
QE_QUERY_MAX_ROWS=500
QE_SYNC_INTERVAL_SECONDS=120
QE_SYNC_MAX_SECONDS=100
QE_PROFILES_PER_PASS=50
QE_DOCS_PER_PASS=200
